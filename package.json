{
  "name": "flashseat-v1",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "docker compose up -d postgres && DATABASE_URL=postgresql://flashseat:flashseat@localhost:5432/flashseat npm run dev --workspace apps/api",
    "dev:db": "docker compose up -d postgres",
    "dev:api": "DATABASE_URL=postgresql://flashseat:flashseat@localhost:5432/flashseat npm run dev --workspace apps/api",
    "down": "docker compose down",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "dependencies": {
    "firebase": "^12.18.0"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
